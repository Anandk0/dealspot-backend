# Example local run script — copy real values, do NOT commit secrets.
# Usage (PowerShell): copy this, fill in your values, run in the backend folder.
cd d:\dealspot\dealspot-backend
$env:PORT = "8081"
$env:CLOUDINARY_CLOUD_NAME = "your-cloud-name"
$env:CLOUDINARY_API_KEY = "your-api-key"
$env:CLOUDINARY_API_SECRET = "your-api-secret"
$env:MAIL_USERNAME = "your-gmail@gmail.com"
$env:MAIL_PASSWORD = "your-gmail-app-password"
$env:EMAIL_OTP_ENABLED = "false"
mvn spring-boot:run
